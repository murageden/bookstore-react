# Dependencies & local modules (speeds up 'npm install' or 'yarn install' inside Docker)
node_modules/
**/node_modules/

# Build outputs (avoids mixing local build artifacts with container build)
dist/
build/
out/

# Environment files and credentials (security risk)
.env
.env.local
.env.*.local
*.env*

# Logs and debug files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Git and version control
.git/
.gitignore

# IDE & Text Editor configurations
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
.DS_Store
Thumbs.db

# Docker configuration files (the image doesn't need to hold its own blueprints)
Dockerfile
.dockerignore
docker-compose*.yml

# Testing artifacts
coverage/
.eslintcache